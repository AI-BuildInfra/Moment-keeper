rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidDatePattern(dateStr) {
      return dateStr is string && dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // HIGH FIX #9: Validate spotifyUrl must be Spotify domain or absent.
    function isValidSpotifyUrl(val) {
      return !('spotifyUrl' in val) ||
             val.spotifyUrl == null ||
             val.spotifyUrl == '' ||
             (val.spotifyUrl is string && val.spotifyUrl.matches('^https://open\\.spotify\\.com/.*'));
    }

    // Users Collection rules
    // Public user profile information is readable by authenticated users so members
    // can view names in shared groups and invite collaborators by email.
    // Private passkey secrets are stored in the /private/secrets subcollection, which
    // is strictly restricted to the document owner only.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && !('privatePasskey' in request.resource.data);

      // Private settings subcollection — only owner has access
      match /private/secrets {
        allow read, write: if isOwner(userId);
      }
    }

    // Events Collection rules
    match /events/{eventId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || (
          'groupId' in resource.data &&
          resource.data.groupId != null &&
          resource.data.groupId != '' &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.memberIds
        )
      );

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && (!('groupId' in request.resource.data) || request.resource.data.groupId == null || request.resource.data.groupId == '' || (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds
        ))
        && isValidString(request.resource.data.title, 1, 100)
        && isValidDatePattern(request.resource.data.date)
        && request.resource.data.category in ['birthday', 'anniversary', 'wedding', 'family', 'personal', 'holiday', 'business', 'custom']
        && request.resource.data.priority in ['low', 'medium', 'high', 'critical']
        && request.resource.data.isFavorite is bool
        && request.resource.data.isArchived is bool
        && request.resource.data.tags is list
        // LOW FIX #20: Enforce max lengths on optional text fields
        && (!('description' in request.resource.data) || isValidString(request.resource.data.description, 0, 5000))
        && (!('notes' in request.resource.data) || isValidString(request.resource.data.notes, 0, 10000))
        // HIGH FIX #9: Restrict spotifyUrl to Spotify domain only
        && isValidSpotifyUrl(request.resource.data);

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && (!('groupId' in request.resource.data) || request.resource.data.groupId == null || request.resource.data.groupId == '' || (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds
        ))
        && isValidString(request.resource.data.title, 1, 100)
        && isValidDatePattern(request.resource.data.date)
        && request.resource.data.category in ['birthday', 'anniversary', 'wedding', 'family', 'personal', 'holiday', 'business', 'custom']
        && request.resource.data.priority in ['low', 'medium', 'high', 'critical']
        && request.resource.data.isFavorite is bool
        && request.resource.data.isArchived is bool
        && request.resource.data.tags is list
        // LOW FIX #20: Enforce max lengths on optional text fields
        && (!('description' in request.resource.data) || isValidString(request.resource.data.description, 0, 5000))
        && (!('notes' in request.resource.data) || isValidString(request.resource.data.notes, 0, 10000))
        // HIGH FIX #9: Restrict spotifyUrl to Spotify domain only
        && isValidSpotifyUrl(request.resource.data);

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Persons Collection rules
    match /persons/{personId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.name, 1, 100)
        && request.resource.data.isFavorite is bool
        && request.resource.data.tags is list
        && request.resource.data.giftIdeas is list
        && request.resource.data.previousGifts is list
        && (!('nickname' in request.resource.data) || request.resource.data.nickname is string)
        && (!('gender' in request.resource.data) || request.resource.data.gender is string)
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string)
        && (!('relationship' in request.resource.data) || request.resource.data.relationship is string)
        && (!('notes' in request.resource.data) || isValidString(request.resource.data.notes, 0, 10000));

      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidString(request.resource.data.name, 1, 100)
        && request.resource.data.isFavorite is bool
        && request.resource.data.tags is list
        && request.resource.data.giftIdeas is list
        && request.resource.data.previousGifts is list
        && (!('nickname' in request.resource.data) || request.resource.data.nickname is string)
        && (!('gender' in request.resource.data) || request.resource.data.gender is string)
        && (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string)
        && (!('relationship' in request.resource.data) || request.resource.data.relationship is string)
        && (!('notes' in request.resource.data) || isValidString(request.resource.data.notes, 0, 10000));

      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Groups Collection rules
    match /groups/{groupId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.memberIds);

      allow create: if isAuthenticated()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100;

      // Group privilege escalation fix:
      // 1. Group owners can update any group field
      // 2. Regular members can update non-structural fields (name, description)
      // 3. Regular members can leave the group by removing ONLY their own UID from memberIds
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        ||
        (
          request.auth.uid in resource.data.memberIds
          && !('memberIds' in request.resource.data.diff(resource.data).affectedKeys())
          && !('ownerId' in request.resource.data.diff(resource.data).affectedKeys())
        )
        ||
        (
          request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && !('ownerId' in request.resource.data.diff(resource.data).affectedKeys())
        )
      );

      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }
  }
}
